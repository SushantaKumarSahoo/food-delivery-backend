model SearchAnalyticsAggregate {
  id                    String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId              String    @map("tenant_id") @db.Uuid
  date                  DateTime  @db.Date
  queryText             String    @map("query_text") @db.VarChar(500)
  searchCount           Int       @default(0) @map("search_count")
  clickThroughCount     Int       @default(0) @map("click_through_count")
  orderConversionCount  Int       @default(0) @map("order_conversion_count")
  zeroResultsCount      Int       @default(0) @map("zero_results_count")
  avgResultsCount       Decimal?  @map("avg_results_count") @db.Decimal(8,2)
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt             DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  tenant                PlatformTenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, date, queryText])
  @@map("search_analytics_aggregates")
}

model CustomerCohort {
