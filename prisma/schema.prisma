generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions", "views"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  directUrl  = env("DIRECT_URL")
  extensions = [pg_trgm, pgcrypto]
}

// ============================================================
// 1. PLATFORM TENANT
// ============================================================

model PlatformTenant {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name          String    @db.VarChar(200)
  slug          String    @unique @db.VarChar(100)
  domain        String?   @unique @db.VarChar(255)
  countryCode   String    @map("country_code") @db.Char(2)
  currencyCode  String    @map("currency_code") @db.Char(3)
  timezone      String    @default("Asia/Kolkata") @db.VarChar(60)
  locale        String    @default("en-IN") @db.VarChar(20)
  status        String    @default("active") @db.VarChar(20)
  config        Json      @default("{}")
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt     DateTime? @map("deleted_at") @db.Timestamptz
  rowVersion    Int       @default(1) @map("row_version")

  users               User[]
  roles               Role[]
  customerProfiles    CustomerProfile[]
  merchants           Merchant[]
  stores              Store[]
  verticals           Vertical[]
  categories          Category[]
  products            Product[]
  carts               Cart[]
  orders              Order[]
  payments            Payment[]
  merchantSettlements MerchantSettlement[]
  deliveryPartners    DeliveryPartner[]
  deliveryZones       DeliveryZone[]
  subscriptionPlans   SubscriptionPlan[]
  subscriptions       Subscription[]
  loyaltyTiers        LoyaltyTier[]
  wallets             Wallet[]
  rewardPoints        RewardPointsLedger[]
  couponCampaigns     CouponCampaign[]
  corporateAccounts   CorporateAccount[]
  groupOrders         GroupOrder[]
  tasteProfiles       TasteProfile[]
  reviews             Review[]
  notificationTmpls   NotificationTemplate[]
  notifications       Notification[]
  supportTickets      SupportTicket[]
  faqArticles         FaqArticle[]
  banners             Banner[]
  homeSections        HomeSection[]
  promotions          Promotion[]
  adminUsers          AdminUser[]
  adminRoles          AdminRole[]
  featureFlags        FeatureFlag[]
  insurancePlans      PartnerInsurancePlan[]
  searchAggregates    SearchAnalyticsAggregate[]
  cohorts             CustomerCohort[]

  @@map("platform_tenants")
}

// ============================================================
// 2. AUTH DOMAIN
// ============================================================

model User {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userRefId         String?   @unique @map("user_ref_id") @db.Uuid // maps to auth.users
  tenantId          String    @map("tenant_id") @db.Uuid
  phoneNumber       String    @map("phone_number") @db.VarChar(20)
  phoneCountryCode  String    @default("+91") @map("phone_country_code") @db.VarChar(6)
  email             String?   @db.VarChar(320)
  emailVerifiedAt   DateTime? @map("email_verified_at") @db.Timestamptz
  phoneVerifiedAt   DateTime? @map("phone_verified_at") @db.Timestamptz
  firstName         String    @default("") @map("first_name") @db.VarChar(100)
  lastName          String    @default("") @map("last_name") @db.VarChar(100)
  displayName       String?   @map("display_name") @db.VarChar(200)
  avatarUrl         String?   @map("avatar_url") @db.Text
  gender            String?   @db.VarChar(20)
  dateOfBirth       DateTime? @map("date_of_birth") @db.Date
  referralCode      String?   @unique @map("referral_code") @db.VarChar(20)
  referredByUserId  String?   @map("referred_by_user_id") @db.Uuid
  languageCode      String    @default("en") @map("language_code") @db.VarChar(10)
  status            String    @default("active") @db.VarChar(30)
  lastLoginAt       DateTime? @map("last_login_at") @db.Timestamptz
  loginCount        Int       @default(0) @map("login_count")
  isTestUser        Boolean   @default(false) @map("is_test_user")
  fcmToken          String?   @map("fcm_token") @db.Text
  metadata          Json      @default("{}")
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt         DateTime? @map("deleted_at") @db.Timestamptz
  createdBy         String?   @map("created_by") @db.Uuid
  updatedBy         String?   @map("updated_by") @db.Uuid
  rowVersion        Int       @default(1) @map("row_version")

  tenant            PlatformTenant @relation(fields: [tenantId], references: [id])
  referredByUser    User?          @relation("UserReferrals", fields: [referredByUserId], references: [id])
  referrals         User[]         @relation("UserReferrals")

  devices                 UserDevice[]
  sessions                Session[]
  otpVerifications        OtpVerification[]
  socialAccounts          SocialAccount[]
  roles                   UserRole[]
  customerProfile         CustomerProfile?
  customerPreferences     CustomerPreference?
  savedAddresses          SavedAddress[]
  customerActivity        CustomerActivity[]
  ownedMerchants          Merchant[]
  carts                   Cart[]
  orders                  Order[]
  paymentMethods          PaymentMethod[]
  payments                Payment[]
  refunds                 Refund[]
  deliveryPartner         DeliveryPartner?
  subscriptions           Subscription[]
  subscriptionUsage       SubscriptionUsage[]
  wallet                  Wallet?
  walletTransactions      WalletTransaction[]
  rewardPoints            RewardPointsLedger[]
  couponRedemptions       CouponRedemption[]
  createdGroupOrders      GroupOrder[]
  groupMemberships        GroupMember[]
  groupCartItems          GroupCartItem[]
  groupPayments           GroupPayment[]
  tasteProfile            TasteProfile?
  recommendationEvents    RecommendationEvent[]
  recommendationClicks    RecommendationClick[]
  searchBehavior          SearchBehavior[]
  cartAbandonmentEvents   CartAbandonmentEvent[]
  reorderPatterns         ReorderPattern[]
  healthProfile           HealthProfile?
  nutritionGoals          NutritionGoal[]
  mealTracking            MealTracking[]
  healthRecommendations   HealthRecommendation[]
  reviews                 Review[]
  reviewVotes             ReviewVote[]
  merchantResponses       MerchantResponse[]
  notifications           Notification[]
  pushLogs                PushLog[]
  emailLogs               EmailLog[]
  smsLogs                 SmsLog[]
  inAppNotificationReads  InAppNotificationRead[]
  supportTickets          SupportTicket[]
  ticketMessages          TicketMessage[]
  stockMovements          StockMovement[]

  @@unique([tenantId, phoneNumber])
  @@unique([tenantId, email])
  @@map("users")
}

model UserDevice {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId            String    @map("user_id") @db.Uuid
  deviceFingerprint String    @map("device_fingerprint") @db.VarChar(255)
  deviceType        String    @map("device_type") @db.VarChar(20)
  osVersion         String?   @map("os_version") @db.VarChar(50)
  appVersion        String?   @map("app_version") @db.VarChar(20)
  pushToken         String?   @map("push_token") @db.Text
  pushProvider      String?   @map("push_provider") @db.VarChar(20)
  deviceName        String?   @map("device_name") @db.VarChar(200)
  deviceModel       String?   @map("device_model") @db.VarChar(100)
  isTrusted         Boolean   @default(false) @map("is_trusted")
  lastActiveAt      DateTime? @map("last_active_at") @db.Timestamptz
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt         DateTime? @map("deleted_at") @db.Timestamptz
  rowVersion        Int       @default(1) @map("row_version")

  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessions          Session[]
  pushLogs          PushLog[]

  @@unique([userId, deviceFingerprint])
  @@map("user_devices")
}

model Session {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId            String    @map("user_id") @db.Uuid
  deviceId          String?   @map("device_id") @db.Uuid
  refreshTokenHash  String    @unique @map("refresh_token_hash") @db.Text
  accessTokenJti    String    @map("access_token_jti") @db.Uuid
  ipAddress         String?   @map("ip_address") @db.Inet
  userAgent         String?   @map("user_agent") @db.Text
  locationCity      String?   @map("location_city") @db.VarChar(100)
  locationCountry   String?   @map("location_country") @db.Char(2)
  expiresAt         DateTime  @map("expires_at") @db.Timestamptz
  revokedAt         DateTime? @map("revoked_at") @db.Timestamptz
  revocationReason  String?   @map("revocation_reason") @db.VarChar(100)
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  rowVersion        Int       @default(1) @map("row_version")

  user              User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  device            UserDevice? @relation(fields: [deviceId], references: [id])

  @@map("sessions")
}

model OtpVerification {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId            String?   @map("user_id") @db.Uuid
  recipient         String    @db.VarChar(320)
  recipientType     String    @map("recipient_type") @db.VarChar(10)
  otpHash           String    @map("otp_hash") @db.Text
  purpose           String    @db.VarChar(50)
  attemptCount      Int       @default(0) @map("attempt_count") @db.SmallInt
  maxAttempts       Int       @default(5) @map("max_attempts") @db.SmallInt
  isVerified        Boolean   @default(false) @map("is_verified")
  verifiedAt        DateTime? @map("verified_at") @db.Timestamptz
  expiresAt         DateTime  @map("expires_at") @db.Timestamptz
  ipAddress         String?   @map("ip_address") @db.Inet
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz
  rowVersion        Int       @default(1) @map("row_version")

  user              User?     @relation(fields: [userId], references: [id])

  @@map("otp_verifications")
}

model SocialAccount {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId            String    @map("user_id") @db.Uuid
  provider          String    @db.VarChar(30)
  providerUserId    String    @map("provider_user_id") @db.VarChar(255)
  email             String?   @db.VarChar(320)
  displayName       String?   @map("display_name") @db.VarChar(200)
  avatarUrl         String?   @map("avatar_url") @db.Text
  tokenExpiresAt    DateTime? @map("token_expires_at") @db.Timestamptz
  rawProfile        Json      @default("{}") @map("raw_profile")
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt         DateTime? @map("deleted_at") @db.Timestamptz
  rowVersion        Int       @default(1) @map("row_version")

  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerUserId])
  @@map("social_accounts")
}

model Role {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId          String    @map("tenant_id") @db.Uuid
  name              String    @db.VarChar(100)
  slug              String    @db.VarChar(100)
  description       String?   @db.Text
  isSystemRole      Boolean   @default(false) @map("is_system_role")
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt         DateTime? @map("deleted_at") @db.Timestamptz
  rowVersion        Int       @default(1) @map("row_version")

  tenant            PlatformTenant    @relation(fields: [tenantId], references: [id])
  rolePermissions   RolePermission[]
  userRoles         UserRole[]

  @@unique([tenantId, slug])
  @@map("roles")
}

model Permission {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  resource          String    @db.VarChar(100)
  action            String    @db.VarChar(50)
  description       String?   @db.Text
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz

  rolePermissions   RolePermission[]

  @@unique([resource, action])
  @@map("permissions")
}

model RolePermission {
  roleId            String    @map("role_id") @db.Uuid
  permissionId      String    @map("permission_id") @db.Uuid
  grantedAt         DateTime  @default(now()) @map("granted_at") @db.Timestamptz
  grantedBy         String?   @map("granted_by") @db.Uuid

  role              Role        @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission        Permission  @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model UserRole {
  userId            String    @map("user_id") @db.Uuid
  roleId            String    @map("role_id") @db.Uuid
  contextType       String?   @map("context_type") @db.VarChar(50)
  contextId         String?   @map("context_id") @db.Uuid
  assignedAt        DateTime  @default(now()) @map("assigned_at") @db.Timestamptz
  assignedBy        String?   @map("assigned_by") @db.Uuid
  expiresAt         DateTime? @map("expires_at") @db.Timestamptz

  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  role              Role      @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_roles")
}

model AuditLog {
  id                String    @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId          String    @map("tenant_id") @db.Uuid
  actorId           String?   @map("actor_id") @db.Uuid
  actorType         String    @default("user") @map("actor_type") @db.VarChar(30)
  action            String    @db.VarChar(100)
  resourceType      String?   @map("resource_type") @db.VarChar(100)
  resourceId        String?   @map("resource_id") @db.Uuid
  oldValues         Json?     @map("old_values")
  newValues         Json?     @map("new_values")
  ipAddress         String?   @map("ip_address") @db.Inet
  userAgent         String?   @map("user_agent") @db.Text
  metadata          Json      @default("{}")
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz

  @@id([id, createdAt])
  @@map("audit_logs")
}

// ============================================================
// 3. CUSTOMER DOMAIN
// ============================================================

model CustomerProfile {
  id                  String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId              String    @unique @map("user_id") @db.Uuid
  tenantId            String    @map("tenant_id") @db.Uuid
  customerSegment     String    @default("new") @map("customer_segment") @db.VarChar(50)
  lifetimeOrderCount  Int       @default(0) @map("lifetime_order_count")
  lifetimeOrderValue  Decimal   @default(0) @map("lifetime_order_value") @db.Decimal(14,2)
  avgOrderValue       Decimal   @default(0) @map("avg_order_value") @db.Decimal(10,2)
  lastOrderAt         DateTime? @map("last_order_at") @db.Timestamptz
  defaultAddressId    String?   @map("default_address_id") @db.Uuid
  preferredPayment    String?   @map("preferred_payment") @db.VarChar(50)
  communicationPrefs  Json      @default("{\"email\":true,\"sms\":true,\"push\":true}") @map("communication_prefs")
  totalRewardPoints   Int       @default(0) @map("total_reward_points")
  loyaltyTierId       String?   @map("loyalty_tier_id") @db.Uuid
  trustScore          Float     @default(100.0) @map("trust_score")
  calorieGoalDaily    Int?      @map("calorie_goal_daily")
  notes               String?   @db.Text
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt           DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt           DateTime? @map("deleted_at") @db.Timestamptz
  rowVersion          Int       @default(1) @map("row_version")

  user                User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant              PlatformTenant @relation(fields: [tenantId], references: [id])
  defaultAddress      SavedAddress?  @relation("DefaultAddress", fields: [defaultAddressId], references: [id])
  loyaltyTier         LoyaltyTier?   @relation(fields: [loyaltyTierId], references: [id])

  @@map("customer_profiles")
}

model CustomerPreference {
  id                  String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId              String    @unique @map("user_id") @db.Uuid
  dietaryPreferences  String[]  @default([]) @map("dietary_preferences")
  cuisinePreferences  String[]  @default([]) @map("cuisine_preferences")
  allergens           String[]  @default([])
  dislikedIngredients String[]  @default([]) @map("disliked_ingredients")
  spiceLevel          String    @default("medium") @map("spice_level") @db.VarChar(20)
  preferredOrderTime  Json      @default("{}") @map("preferred_order_time")
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt           DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  rowVersion          Int       @default(1) @map("row_version")

  user                User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("customer_preferences")
}

model SavedAddress {
  id                    String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId                String    @map("user_id") @db.Uuid
  label                 String    @default("Home") @db.VarChar(50)
  customLabel           String?   @map("custom_label") @db.VarChar(100)
  fullAddress           String    @map("full_address") @db.Text
  addressLine1          String    @map("address_line_1") @db.VarChar(255)
  addressLine2          String?   @map("address_line_2") @db.VarChar(255)
  landmark              String?   @db.VarChar(255)
  city                  String    @db.VarChar(100)
  state                 String    @db.VarChar(100)
  postalCode            String    @map("postal_code") @db.VarChar(20)
  countryCode           String    @default("IN") @map("country_code") @db.Char(2)
  latitude              Float     @db.DoublePrecision
  longitude             Float     @db.DoublePrecision
  geoPoint              Unsupported("geography(Point,4326)")? @map("geo_point")
  deliveryInstructions  String?   @map("delivery_instructions") @db.Text
  isDefault             Boolean   @default(false) @map("is_default")
  floorNumber           String?   @map("floor_number") @db.VarChar(20)
  apartmentNumber       String?   @map("apartment_number") @db.VarChar(50)
  buildingName          String?   @map("building_name") @db.VarChar(200)
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt             DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt             DateTime? @map("deleted_at") @db.Timestamptz
  rowVersion            Int       @default(1) @map("row_version")

  user                  User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  customerProfiles      CustomerProfile[] @relation("DefaultAddress")
  orders                Order[]
  groupOrders           GroupOrder[]

  @@map("saved_addresses")
}

model CustomerActivity {
  id            String    @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId        String    @map("user_id") @db.Uuid
  tenantId      String    @map("tenant_id") @db.Uuid
  sessionId     String?   @map("session_id") @db.Uuid
  eventType     String    @map("event_type") @db.VarChar(100)
  entityType    String?   @map("entity_type") @db.VarChar(50)
  entityId      String?   @map("entity_id") @db.Uuid
  screenName    String?   @map("screen_name") @db.VarChar(100)
  properties    Json      @default("{}")
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz

  user          User      @relation(fields: [userId], references: [id])

  @@id([id, createdAt])
  @@map("customer_activity")
}

// ============================================================
// 4. MERCHANT DOMAIN
// ============================================================

model Merchant {
  id                  String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId            String    @map("tenant_id") @db.Uuid
  ownerUserId         String?   @map("owner_user_id") @db.Uuid
  legalName           String    @map("legal_name") @db.VarChar(300)
  brandName           String    @map("brand_name") @db.VarChar(300)
  slug                String    @db.VarChar(200)
  businessType        String    @map("business_type") @db.VarChar(50)
  taxId               String?   @map("tax_id") @db.VarChar(50)
  panNumber           String?   @map("pan_number") @db.VarChar(20)
  registrationNumber  String?   @map("registration_number") @db.VarChar(100)
  contactEmail        String    @map("contact_email") @db.VarChar(320)
  contactPhone        String    @map("contact_phone") @db.VarChar(20)
  supportEmail        String?   @map("support_email") @db.VarChar(320)
  websiteUrl          String?   @map("website_url") @db.Text
  logoUrl             String?   @map("logo_url") @db.Text
  coverImageUrl       String?   @map("cover_image_url") @db.Text
  bankAccountId       String?   @map("bank_account_id") @db.Uuid
  status              String    @default("pending") @db.VarChar(30)
  onboardedAt         DateTime? @map("onboarded_at") @db.Timestamptz
  contractSignedAt    DateTime? @map("contract_signed_at") @db.Timestamptz
  commissionRate      Decimal   @default(15.00) @map("commission_rate") @db.Decimal(5,2)
  metadata            Json      @default("{}")
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt           DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt           DateTime? @map("deleted_at") @db.Timestamptz
  createdBy           String?   @map("created_by") @db.Uuid
  updatedBy           String?   @map("updated_by") @db.Uuid
  rowVersion          Int       @default(1) @map("row_version")

  tenant              PlatformTenant        @relation(fields: [tenantId], references: [id])
  ownerUser           User?                 @relation(fields: [ownerUserId], references: [id])
  bankAccount         MerchantBankAccount?  @relation("MerchantBank", fields: [bankAccountId], references: [id])
  
  stores              Store[]
  bankAccounts        MerchantBankAccount[]
  storeDocuments      StoreDocument[]
  orders              Order[]
  settlements         MerchantSettlement[]
  commissions         MerchantCommission[]
  merchantResponses   MerchantResponse[]
  aiInsights          AiInsight[]

  @@unique([tenantId, slug])
  @@map("merchants")
}

model MerchantBankAccount {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  merchantId        String    @map("merchant_id") @db.Uuid
  accountHolderName String    @map("account_holder_name") @db.VarChar(200)
  bankName          String    @map("bank_name") @db.VarChar(200)
  accountNumberEnc  String    @map("account_number_enc") @db.Text
  ifscCode          String?   @map("ifsc_code") @db.VarChar(20)
  swiftCode         String?   @map("swift_code") @db.VarChar(20)
  iban              String?   @db.VarChar(50)
  accountType       String    @default("current") @map("account_type") @db.VarChar(20)
  isPrimary         Boolean   @default(false) @map("is_primary")
  isVerified        Boolean   @default(false) @map("is_verified")
  verifiedAt        DateTime? @map("verified_at") @db.Timestamptz
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt         DateTime? @map("deleted_at") @db.Timestamptz
  rowVersion        Int       @default(1) @map("row_version")

  merchant          Merchant  @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  primaryMerchants  Merchant[] @relation("MerchantBank")
  settlements       MerchantSettlement[]

  @@map("merchant_bank_accounts")
}

model Store {
