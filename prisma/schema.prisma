  partner         DeliveryPartner     @relation(fields: [partnerId], references: [id])
  assignment      DeliveryAssignment? @relation(fields: [assignmentId], references: [id])

  @@id([id, earningDate])
  @@map("partner_earnings")
}

model PartnerInsurancePlan {
  id                  String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId            String    @map("tenant_id") @db.Uuid
  name                String    @db.VarChar(300)
  insuranceType       String    @map("insurance_type") @db.VarChar(50)
  provider            String    @db.VarChar(200)
  sumInsured          Decimal   @map("sum_insured") @db.Decimal(12,2)
  annualPremium       Decimal   @map("annual_premium") @db.Decimal(10,2)
  platformContributionPct Decimal @default(100) @map("platform_contribution_pct") @db.Decimal(5,2)
  minOrdersPerMonth   Int       @default(0) @map("min_orders_per_month") @db.SmallInt
  coverageDetails     Json      @default("{}") @map("coverage_details")
  isActive            Boolean   @default(true) @map("is_active")
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt           DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt           DateTime? @map("deleted_at") @db.Timestamptz
  rowVersion          Int       @default(1) @map("row_version")

  tenant              PlatformTenant @relation(fields: [tenantId], references: [id])
  enrollments         PartnerInsuranceEnrollment[]

  @@map("partner_insurance_plans")
}

model PartnerInsuranceEnrollment {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  partnerId       String    @map("partner_id") @db.Uuid
  planId          String    @map("plan_id") @db.Uuid
  policyNumber    String?   @map("policy_number") @db.VarChar(100)
  enrolledAt      DateTime  @default(dbgenerated("CURRENT_DATE")) @map("enrolled_at") @db.Date
  expiresAt       DateTime  @map("expires_at") @db.Date
  status          String    @default("active") @db.VarChar(20)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  rowVersion      Int       @default(1) @map("row_version")

  partner         DeliveryPartner      @relation(fields: [partnerId], references: [id])
  plan            PartnerInsurancePlan @relation(fields: [planId], references: [id])

  @@map("partner_insurance_enrollments")
}

model AiInsight {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  storeId         String    @map("store_id") @db.Uuid
  merchantId      String    @map("merchant_id") @db.Uuid
  insightType     String    @map("insight_type") @db.VarChar(60)
  title           String    @db.VarChar(500)
  summary         String    @db.Text
  dataPayload     Json      @default("{}") @map("data_payload")
  priority        String    @default("medium") @db.VarChar(20)
  periodFrom      DateTime? @map("period_from") @db.Date
  periodTo        DateTime? @map("period_to") @db.Date
  modelVersion    String?   @map("model_version") @db.VarChar(20)
  confidenceScore Decimal?  @map("confidence_score") @db.Decimal(5,4)
  isRead          Boolean   @default(false) @map("is_read")
  isActioned      Boolean   @default(false) @map("is_actioned")
  actionedAt      DateTime? @map("actioned_at") @db.Timestamptz
  expiresAt       DateTime? @map("expires_at") @db.Timestamptz
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz

  store           Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)
  merchant        Merchant  @relation(fields: [merchantId], references: [id])

  @@map("ai_insights")
}

model DemandForecast {
  id                      String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  storeId                 String    @map("store_id") @db.Uuid
  productId               String?   @map("product_id") @db.Uuid
  categoryId              String?   @map("category_id") @db.Uuid
  forecastDate            DateTime  @map("forecast_date") @db.Date
  forecastHour            Int?      @map("forecast_hour") @db.SmallInt
  predictedOrders         Decimal   @map("predicted_orders") @db.Decimal(10,2)
  predictedRevenue        Decimal   @map("predicted_revenue") @db.Decimal(12,2)
  actualOrders            Decimal?  @map("actual_orders") @db.Decimal(10,2)
  actualRevenue           Decimal?  @map("actual_revenue") @db.Decimal(12,2)
  confidenceIntervalLow   Decimal?  @map("confidence_interval_low") @db.Decimal(10,2)
  confidenceIntervalHigh  Decimal?  @map("confidence_interval_high") @db.Decimal(10,2)
  modelVersion            String?   @map("model_version") @db.VarChar(20)
  createdAt               DateTime  @default(now()) @map("created_at") @db.Timestamptz

  store                   Store     @relation(fields: [storeId], references: [id])
  product                 Product?  @relation(fields: [productId], references: [id])
  category                Category? @relation(fields: [categoryId], references: [id])

  @@map("demand_forecasts")
}

model RevenueOptimizationSuggestion {
  id                    String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  storeId               String    @map("store_id") @db.Uuid
  productId             String?   @map("product_id") @db.Uuid
  suggestionType        String    @map("suggestion_type") @db.VarChar(60)
  currentValue          Json?     @map("current_value")
  suggestedValue        Json?     @map("suggested_value")
  expectedRevenueLift   Decimal?  @map("expected_revenue_lift") @db.Decimal(8,2)
  reasoning             String?   @db.Text
  status                String    @default("pending") @db.VarChar(20)
  implementedAt         DateTime? @map("implemented_at") @db.Timestamptz
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz

  store                 Store     @relation(fields: [storeId], references: [id])
  product               Product?  @relation(fields: [productId], references: [id])

  @@map("revenue_optimization_suggestions")
}

